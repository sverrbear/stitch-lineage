  {
    "id": 604,
    "name": "Customer order counts (MBQL 5)",
    "description": "MBQL 5 native stage: CTE, star, join, fully qualified table",
    "collection_id": 7,
    "archived": false,
    "display": "bar",
    "query_type": "native",
    "creator_id": 6,
    "creator": { "id": 6, "common_name": "Magnus", "email": "magnus@smitten.fun" },
    "dataset_query": {
      "database": 2,
      "lib/type": "mbql/query",
      "stages": [
        {
          "lib/type": "mbql.stage/native",
          "native": "with recent as (select * from analytics_wh.marts.fct_orders where created_at >= '2020-01-01') select c.customer_name, count(*) as orders from recent as r join marts.dim_customers as c on c.customer_id = r.customer_id group by c.customer_name"
        }
      ]
    }
  },
