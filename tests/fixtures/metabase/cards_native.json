[
  {
    "id": 601,
    "name": "Orders export",
    "description": "Every value tag type, plus an optional clause",
    "collection_id": 7,
    "archived": false,
    "display": "table",
    "query_type": "native",
    "creator_id": 6,
    "creator": { "id": 6, "common_name": "Magnus", "email": "magnus@smitten.fun" },
    "dataset_query": {
      "type": "native",
      "database": 2,
      "native": {
        "query": "select order_id, order_total from fct_orders where order_total > {{min_total}} [[and created_at >= {{start_date}}]] and customer_id = {{customer}} limit {{row_cap}}",
        "template-tags": {
          "min_total": { "name": "min_total", "display-name": "Min total", "type": "number" },
          "start_date": { "name": "start_date", "display-name": "Start date", "type": "date" },
          "customer": { "name": "customer", "display-name": "Customer", "type": "text" },
          "row_cap": { "name": "row_cap", "display-name": "Row cap", "type": "number" }
        }
      }
    }
  },
